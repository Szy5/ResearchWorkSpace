    {
      "id": "fig-npueval-results",
      "label": "fig:npueval_results",
      "caption": "GEPA with GPT-4o is able to generate kernels for AMD NPUs that achieve vector utilization rates as high as 70\\%, with a mean utilization score of 30.52\\%. In comparison, GPT-4o, even after up to 10 sequential refinements with environment feedback, achieves an aggregate score of only 4.25\\%. When enhanced with retrieval-augmented generation (RAG) and MIPRO, the sequential refinement agent improves to scores of 16.33\\% and 19.03\\%, respectively. Notably, the final prompt produced by GEPA enables the same agent to reach a utilization score of 26.85\\%, all without requiring any runtime RAG.",
      "source_path": "figures/kernelcode/npueval_vec_util_gpt4o.pdf",
      "asset_path": "assets/figures/npueval-results.jpg",
      "section_id": "sec-gepa-for-inference-time-search-contd",
      "status": "rendered",
      "source_sha256": "3703d3f44a640d002247f41eb04983bf3f80a74d8387fbd0ce6c24b9fd3552c5",
      "media_type": "pdf"
    },
