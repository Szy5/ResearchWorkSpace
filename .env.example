MODEL_NAME=your-model-name
BASE_URL=https://your-api-base-url/v1
API_KEY=your-api-key

# Optional LangSmith (LangChain Agent Lake) tracing for agent mode
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_your-langsmith-api-key
# LANGSMITH_PROJECT=paper-wiki-reader
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional Agent Loop mode & budgets (INGEST_MODE=agent enables agent mode for CLI & Web by default)
# INGEST_MODE=agent
# AGENT_MAX_STEPS=8
# AGENT_MAX_READ_LINES=150
# AGENT_MAX_GREP_MATCHES=25

# Optional path overrides (defaults live under KnowledgeBase/)
# KNOWLEDGE_BASE_DIR=/absolute/path/to/KnowledgeBase
# RAW_DIR=/absolute/path/to/KnowledgeBase/raw
# ARTIFACTS_DIR=/absolute/path/to/KnowledgeBase/artifacts
# GRAPH_STATE_DIR=/absolute/path/to/KnowledgeBase/graph_state
# GRAPH_UPDATES_DIR=/absolute/path/to/KnowledgeBase/graph_updates
# PROMPTS_DIR=/absolute/path/to/prompts
